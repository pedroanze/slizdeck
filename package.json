{
  "name": "slizdeck",
  "version": "2.0.1",
  "description": "Agent Skill que genera decks de slides HTML animados desde tu design system",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/pedroanze/slizdeck#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pedroanze/slizdeck.git"
  },
  "bugs": {
    "url": "https://github.com/pedroanze/slizdeck/issues"
  },
  "keywords": [
    "agent-skill",
    "claude-code",
    "slides",
    "pitch-deck",
    "html-presentation",
    "claude-code-plugin",
    "codex",
    "gemini-cli",
    "opencode"
  ],
  "author": "@pedroanze",
  "bin": {
    "slizdeck": "bin/slizdeck.mjs"
  },
  "files": [
    "SKILL.md",
    "template.html",
    "styles/",
    "reference/",
    "scripts/",
    "bin/",
    "hooks/",
    ".claude-plugin/",
    "CHANGELOG.md",
    "DESIGN.md",
    "design.json",
    "NOTICE.md",
    "README.en.md",
    "examples/demo-deck.html",
    "examples/pitch-showcase.html"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check-versions": "node scripts/check-versions.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "export:pptx": "node scripts/export-pptx.mjs",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check-versions.mjs && node scripts/check-docs.mjs && npm test",
    "check-docs": "node scripts/check-docs.mjs"
  },
  "dependencies": {
    "node-html-parser": "^6.1.13",
    "pptxgenjs": "^4.0.1"
  }
}
